# Base de données PostgreSQL (Neon, Supabase, Railway...)
# Remplacez par vos vraies valeurs depuis votre provider de base de données

# URL de connexion poolée (pour Prisma ORM en production serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# URL directe (pour les migrations Prisma - Neon uniquement)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Secret de signature des sessions de connexion (OBLIGATOIRE, 32+ caractères aléatoires)
# Générez-en un avec :  openssl rand -base64 32
AUTH_SECRET="remplacez-par-une-longue-valeur-aleatoire"
